{
  "name": "brainstem",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "eval:paired:live:dry-run": "bun run experiments/evals/paired/live/cli.ts dry-run",
    "eval:paired:live": "bun run experiments/evals/paired/live/cli.ts run",
    "eval:paired:live:report": "bun run experiments/evals/paired/live/cli.ts report",
    "eval:paired:dry-run": "bun run experiments/evals/paired/cli.ts dry-run",
    "eval:paired:offline": "bun run experiments/evals/paired/cli.ts offline",
    "eval:paired:report": "bun run experiments/evals/paired/cli.ts report",
    "exp:access": "bun run experiments/01-access.ts",
    "exp:gate": "bun run experiments/02-gate-corpus.ts",
    "exp:timing": "bun run experiments/03-batch-timing.ts",
    "exp:sanitize": "bun run experiments/04-sanitize.ts",
    "eval:live": "bun run experiments/evals/live-scenarios.ts",
    "eval:cache-benchmark": "bun run experiments/evals/cache-benchmark.ts",
    "eval:select": "bun run experiments/evals/select-value.ts",
    "eval:select-vs-self": "bun run experiments/evals/select-vs-selfselect.ts",
    "eval:select-ambiguity": "bun run experiments/evals/select-ambiguity.ts",
    "eval:with-without": "bun run experiments/evals/with-without-harness.ts",
    "eval:focus-vs-rtk": "bun run experiments/evals/focus-vs-rtk.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo -p tsconfig.json",
    "build": "tsdown",
    "build:check": "tsdown --config tsdown.check.config.ts",
    "format": "oxfmt --write \"packages/**/*.ts\" \"packages/*/package.json\" \"experiments/**/*.ts\" \"*.ts\" \"*.json\" \".ox*.json\"",
    "format:check": "oxfmt --check \"packages/**/*.ts\" \"packages/*/package.json\" \"experiments/**/*.ts\" \"*.ts\" \"*.json\" \".ox*.json\"",
    "lint": "oxlint --deny-warnings packages experiments tsdown.config.ts tsdown.check.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.83.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}

{
  "name": "brainstem",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "exp:access": "bun run experiments/01-access.ts",
    "exp:gate": "bun run experiments/02-gate-corpus.ts",
    "exp:timing": "bun run experiments/03-batch-timing.ts",
    "exp:sanitize": "bun run experiments/04-sanitize.ts",
    "eval:live": "bun run experiments/evals/live-scenarios.ts",
    "eval:cache-benchmark": "bun run experiments/evals/cache-benchmark.ts",
    "eval:select": "bun run experiments/evals/select-value.ts",
    "eval:select-vs-self": "bun run experiments/evals/select-vs-selfselect.ts",
    "eval:select-ambiguity": "bun run experiments/evals/select-ambiguity.ts",
    "eval:with-without": "bun run experiments/evals/with-without-harness.ts",
    "eval:focus-vs-rtk": "bun run experiments/evals/focus-vs-rtk.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run --cwd packages/core build && bun run --cwd packages/reflexes build && bun run --cwd packages/pi-adapter build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "tsup": "^8.5.1"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}

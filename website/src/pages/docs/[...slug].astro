---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

interface Props {
  doc: CollectionEntry<"docs">;
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const title = headings.find((heading) => heading.depth === 1)?.text;
if (!title) throw new Error(`docs/${doc.id}.md needs a top-level "# " heading for its page title`);
---

<DocsLayout id={doc.id} title={title} headings={headings}>
  <Content />
</DocsLayout>

<div class="window" data-session-replay>
  <div class="bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="title">agent · deploy-tooling</span>
    <span class="meter"><b data-saved-count>0</b><span>tokens saved</span><span class="plus" data-saved-plus></span></span>
  </div>
  <div class="session-head">
    <span>cwd <b>~/work/deploy-tooling</b></span>
    <span>reflexes <b>select · gate · sanitize · focus</b></span>
    <span>judge <b>jev</b></span>
  </div>
  <div class="feed" data-feed aria-live="polite">
    <div class="idle" data-idle>Session starts when this window is in view.</div>
  </div>
  <div class="foot">
    <span class="state" data-status></span>
    <span class="summary" data-summary></span>
    <button class="replay" type="button" data-replay>Replay</button>
  </div>
</div>
<p class="caption">Scripted replay of a real session shape. No live API calls; token counts are illustrative.</p>

<script>
  import { mountSessionReplay } from "../scripts/session-replay";

  document.querySelectorAll<HTMLElement>("[data-session-replay]").forEach(mountSessionReplay);
</script>

<style is:global>
  [data-session-replay] .row { display: flex; align-items: flex-start; gap: 10px; padding: 3px 8px; border-radius: 6px; border: 1px solid transparent; animation: replay-rise 0.3s ease both; }
  [data-session-replay] .row .who { flex: 0 0 14px; color: var(--ink-faint); }
  [data-session-replay] .row.assistant .who { color: var(--ink); }
  [data-session-replay] .row .txt { flex: 1; min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--ink); }
  [data-session-replay] .row.out .txt { color: var(--ink-soft); }
  [data-session-replay] .row.user .txt { font-weight: 500; }
  [data-session-replay] .row.flagged { background: var(--alert-wash); border-color: var(--alert-line); }
  [data-session-replay] .row.judged { background: var(--bg-subtle); border-color: var(--line); }
  [data-session-replay] .row.folding { animation: replay-fold 0.35s ease forwards; overflow: hidden; }
  [data-session-replay] .tag { flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; font-size: 11px; color: var(--ink-faint); }
  [data-session-replay] .tag b { font-weight: 600; font-size: 10.5px; letter-spacing: 0.06em; padding: 1px 7px; border-radius: 4px; border: 1px solid var(--line-strong); color: var(--ink); }
  [data-session-replay] .tag.solid b { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  [data-session-replay] .tag.alert { color: var(--alert); }
  [data-session-replay] .tag.alert b { background: var(--alert); border-color: var(--alert); color: #ffffff; }
  [data-session-replay] .note { margin: 4px 8px 8px 32px; padding: 9px 12px; border: 1px dashed var(--alert-line); border-radius: 6px; font-size: 12px; color: var(--ink-soft); animation: replay-rise 0.3s ease both; }
  [data-session-replay] .note b { color: var(--alert); font-weight: 600; }
  [data-session-replay] .chip { margin: 2px 8px 8px 32px; display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); font: 11.5px var(--mono); color: var(--ink-soft); cursor: pointer; animation: replay-rise 0.3s ease both; }
  [data-session-replay] .chip:hover { border-color: var(--ink); color: var(--ink); }
  [data-session-replay] .spin { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); margin-right: 8px; animation: replay-blink 0.8s ease-in-out infinite alternate; }
  [data-session-replay] .plus.show { animation: replay-float-up 0.9s ease forwards; }
  @keyframes replay-float-up { 0% { opacity: 0; transform: translateY(3px); } 20% { opacity: 1; transform: none; } 75% { opacity: 1; } 100% { opacity: 0; transform: translateY(-8px); } }
  @keyframes replay-rise { from { opacity: 0; transform: translateY(4px); } }
  @keyframes replay-fold { to { opacity: 0; max-height: 0; padding-block: 0; margin: 0; } }
  @keyframes replay-blink { to { opacity: 0.2; } }

  @media (max-width: 560px) {
    [data-session-replay] .row { flex-wrap: wrap; }
    [data-session-replay] .row .tag { margin-left: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-session-replay] .row, [data-session-replay] .note, [data-session-replay] .chip { animation: none; }
  }
</style>

<style>
  .window { max-width: 960px; margin: 0 auto; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 12px; height: 40px; padding: 0 14px; background: var(--win-bar); border-bottom: 1px solid var(--line); font: 12px var(--mono); color: var(--ink-faint); }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .title { flex: 1; text-align: center; }
  .meter { display: flex; align-items: baseline; gap: 6px; font-variant-numeric: tabular-nums; }
  .meter b { color: var(--ink); font-weight: 600; }
  .plus { color: var(--ink); opacity: 0; font-weight: 600; }
  .session-head { padding: 14px 20px; border-bottom: 1px solid var(--line); font: 12.5px/1.7 var(--mono); color: var(--ink-faint); display: flex; gap: 8px 24px; flex-wrap: wrap; }
  .session-head b { color: var(--ink); font-weight: 500; }
  .feed { height: 400px; overflow-y: auto; padding: 12px 14px; font: 13px/1.65 var(--mono); scroll-behavior: smooth; }
  .feed::-webkit-scrollbar { width: 8px; }
  .feed::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 8px; }
  .idle { height: 100%; display: grid; place-items: center; color: var(--ink-faint); font-size: 12.5px; }
  .foot { border-top: 1px solid var(--line); padding: 12px 20px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; font: 12.5px var(--mono); color: var(--ink-faint); min-height: 50px; }
  .state { flex: 1; min-width: 200px; }
  .summary :global(b) { color: var(--ink); font-weight: 600; }
  .replay { background: none; border: 1px solid var(--line-strong); border-radius: 6px; padding: 4px 10px; font: 12.5px var(--sans); color: var(--ink-soft); cursor: pointer; }
  .replay:hover { color: var(--ink); border-color: var(--ink); }
  .caption { max-width: 960px; margin: 14px auto 0; font: 13px var(--sans); color: var(--ink-faint); text-align: center; }

  @media (max-width: 560px) {
    .feed { height: 360px; font-size: 12px; }
    .title { display: none; }
    .meter { margin-left: auto; }
  }
</style>

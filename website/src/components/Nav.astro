---
import Mark from "./Mark.astro";
import { githubUrl } from "../site";

interface Props {
  isDocs?: boolean;
}

const { isDocs = false } = Astro.props;
---

<nav class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="brainstem home"><Mark class="mark" /></a>
    <ul>
      <li><a href={isDocs ? "/docs/reflexes/" : "/#reflexes"}>Reflexes</a></li>
      <li><a href="/#evidence">Evidence</a></li>
      <li><a href="/docs/" aria-current={isDocs ? "true" : undefined}>Docs</a></li>
    </ul>
    <div class="actions">
      <a class="btn" href={githubUrl}>GitHub</a>
      {!isDocs && <a class="btn primary" href="/docs/">Get started</a>}
    </div>
  </div>
</nav>

<style>
  nav.top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .wrap { display: flex; align-items: center; gap: 28px; height: 60px; }
  .brand { display: block; flex-shrink: 0; }
  .brand :global(.mark) { display: block; width: auto; height: 24px; color: var(--ink); }
  ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; font-size: 14px; }
  ul a { text-decoration: none; color: var(--ink-soft); transition: color 0.15s; }
  ul a:hover, ul a[aria-current] { color: var(--ink); }
  .actions { margin-left: auto; display: flex; gap: 8px; }

  @media (max-width: 900px) {
    ul { display: none; }
  }
  @media (max-width: 560px) {
    .actions .btn:not(.primary):not(:only-child) { display: none; }
  }
</style>

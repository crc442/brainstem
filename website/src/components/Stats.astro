---
const stats = [
  { value: "83.4%", caption: "less tool output sent to the model" },
  { value: "96%", caption: "of full-output accuracy, with 1/6 of the context" },
  { value: "216 ms", caption: "median time for a Focus judgment" },
  { value: "0", caption: "changes to your agent's behavior in shadow mode" },
];
---

<div class="wrap">
  <div class="stats">
    {stats.map((stat) => (
      <div>
        <span class="value">{stat.value}</span>
        <p>{stat.caption}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); }
  .stats > div { padding: 32px 24px; display: grid; gap: 6px; }
  .stats > div + div { border-left: 1px solid var(--line); }
  .value { font: 400 40px/1 var(--pixel); }
  p { font-size: 14px; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats > div:nth-child(3) { border-left: 0; }
    .stats > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>

---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import { docsNav, githubUrl } from "../site";

interface Props {
  id: string;
  title: string;
  headings: MarkdownHeading[];
}

const { id, title, headings } = Astro.props;
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const sourcePath = `docs/${id}.md`;
---

<Base title={`${title} · brainstem docs`} description={`Brainstem documentation: ${title}`}>
  <Nav />
  <div class="wrap docs">
    <aside class="sidebar" aria-label="Documentation">
      <ul>
        {
          docsNav.map((entry) => (
            <li>
              <a href={`/docs/${entry.id}/`} aria-current={entry.id === id ? "page" : undefined}>
                {entry.label}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
    <article class="prose">
      <slot />
      <p class="edit"><a href={`${githubUrl}/blob/main/${sourcePath}`}>Edit this page on GitHub</a></p>
    </article>
    {
      sectionHeadings.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <p class="label">On this page</p>
          <ul>
            {sectionHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 200px minmax(0, 1fr) 200px; gap: 48px; padding-block: 48px 96px; }
  .sidebar, .toc { position: sticky; top: 92px; align-self: start; }
  .sidebar ul, .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sidebar a { display: block; padding: 6px 10px; border-radius: 6px; font-size: 14px; text-decoration: none; color: var(--ink-soft); }
  .sidebar a:hover { background: var(--hover); color: var(--ink); }
  .sidebar a[aria-current="page"] { background: var(--hover); color: var(--ink); font-weight: 500; }
  .toc .label { margin-bottom: 10px; }
  .toc a { display: block; padding: 3px 0; font-size: 13px; text-decoration: none; color: var(--ink-faint); }
  .toc a:hover { color: var(--ink); }

  .prose { font-size: 15px; line-height: 1.7; }
  .prose :global(h1) { font: 600 clamp(30px, 4vw, 40px)/1.1 var(--sans); letter-spacing: -0.03em; margin-bottom: 20px; }
  .prose :global(h2) { font: 600 24px/1.25 var(--sans); letter-spacing: -0.02em; margin: 48px 0 14px; padding-top: 24px; border-top: 1px solid var(--line); scroll-margin-top: 80px; }
  .prose :global(h3) { font: 600 18px/1.3 var(--sans); margin: 32px 0 10px; scroll-margin-top: 80px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(pre), .prose :global(table) { margin: 0 0 16px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(a) { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .prose :global(a:hover) { text-decoration-color: var(--ink); }
  .prose :global(:not(pre) > code) { font: 0.88em var(--mono); background: var(--bg-subtle); border: 1px solid var(--line); border-radius: 5px; padding: 1px 5px; }
  .prose :global(pre) { font: 13px/1.6 var(--mono); padding: 16px 18px; border: 1px solid var(--line); border-radius: 10px; overflow-x: auto; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 14px; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--line); }
  .prose :global(th), .prose :global(td code) { white-space: nowrap; }
  .prose :global(th) { font-weight: 600; }
  .edit { margin-top: 56px !important; font-size: 13px; color: var(--ink-faint); }

  @media (prefers-color-scheme: dark) {
    .prose :global(.astro-code), .prose :global(.astro-code span) { color: var(--shiki-dark) !important; background-color: var(--shiki-dark-bg) !important; }
  }

  @media (max-width: 1100px) {
    .docs { grid-template-columns: 180px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 760px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 24px; }
    .sidebar { position: static; }
    .sidebar ul { display: flex; flex-wrap: wrap; gap: 4px; }
  }
</style>

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@brainstem/core": [
        "./packages/core/src/index.ts"
      ],
      "@brainstem/reflexes": [
        "./packages/reflexes/src/index.ts"
      ],
      "@brainstem/pi-adapter": [
        "./packages/pi-adapter/src/index.ts"
      ]
    }
  },
  "include": [
    "experiments",
    "packages/*/src",
    "packages/*/test",
    "packages/*/examples",
    "vitest.config.ts",
    "packages/*/tsup.config.ts"
  ]
}

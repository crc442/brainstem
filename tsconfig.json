{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@brainstem/core": ["./packages/core/src/index.ts"],
      "@brainstem/reflexes": ["./packages/reflexes/src/index.ts"],
      "@brainstem/reflexes/*": ["./packages/reflexes/src/*"],
      "@brainstem/pi-adapter": ["./packages/pi-adapter/src/index.ts"]
    }
  },
  "include": [
    "experiments",
    "packages/*/src",
    "packages/*/test",
    "packages/*/examples",
    "vitest.config.ts",
    "tsdown.config.ts",
    "tsdown.check.config.ts"
  ]
}
